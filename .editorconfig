# 本项目源码统一使用 UTF-8 + LF + 2 空格缩进。
# 换行已由 .gitattributes（eol=lf）强制，此处为编辑器内的实时约定。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 不裁掉行尾空格（Markdown 里两个空格 = 换行）
[*.md]
trim_trailing_whitespace = false

# Windows 辅助脚本由 PowerShell 5.1 读取，需带 BOM（见 src/main/lib/sapi.cjs）
[*.ps1]
charset = utf-8-bom
