# All source in this project uses UTF-8 + LF + 2-space indent.
# Line endings are enforced by .gitattributes (eol=lf); this is the live convention inside editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown keeps trailing whitespace (two trailing spaces in Markdown = a line break)
[*.md]
trim_trailing_whitespace = false
