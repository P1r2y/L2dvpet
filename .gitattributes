# Every text file in this repo is stored and checked out with LF (verified byte by byte:
# no CRLF, no mixed endings).
# eol=lf makes checkouts identical on every platform and avoids pointless line-ending diffs.
* text=auto eol=lf

# Binary assets: no newline conversion and no text diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.wav    binary
*.mp3    binary
*.moc3   binary
*.cmo3   binary
*.psd    binary
*.zip    binary

# Build output and third-party libraries are excluded from language stats
dist/**                    linguist-generated=true
dist/vendor/**             linguist-vendored=true
vendor/**                  linguist-vendored=true
package-lock.json          linguist-generated=true
