# 本仓库所有文本文件均以 LF 存储与检出（经 byte 级普查确认，无 CRLF、无混合）。
# eol=lf 让各平台检出结果一致，避免换行造成的无意义 diff。
* text=auto eol=lf

# 二进制资源：禁止换行转换与文本 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.wav    binary
*.mp3    binary
*.moc3   binary
*.cmo3   binary
*.psd    binary
*.zip    binary

# 构建产物与第三方库不计入语言统计
dist/**                    linguist-generated=true
dist/vendor/**             linguist-vendored=true
vendor/**                  linguist-vendored=true
package-lock.json          linguist-generated=true
