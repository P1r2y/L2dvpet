{
  "_comment": "一键声线预设。patch 与当前设置深度合并；被锁定的项不会被覆盖。languageProfiles 是自由映射，可任意增删语言键。",
  "presets": [
    {
      "id": "roxy-gsv",
      "label": "洛琪希 · GPT-SoVITS 原声模型",
      "desc": "最还原：社区微调的洛琪希专用模型，需要本地运行 GPT-SoVITS",
      "requires": "gptsovits",
      "patch": {
        "voice": {
          "ttsProvider": "auto",
          "languageMode": "zh-CN",
          "pitchShift": 1.0,
          "volume": 0.9
        }
      }
    },
    {
      "id": "roxy-ja",
      "label": "洛琪希 · 日本語",
      "desc": "日语声线，抬高音调贴近她的年龄感",
      "patch": {
        "voice": {
          "ttsProvider": "auto",
          "languageMode": "ja-JP",
          "pitchShift": 1.15,
          "languageProfiles": {
            "ja-JP": { "openai": "nova", "rate": "+0%" }
          }
        }
      }
    },
    {
      "id": "roxy-zh",
      "label": "洛琪希 · 中文",
      "desc": "中文配音，年轻清亮的女声",
      "patch": {
        "voice": {
          "ttsProvider": "auto",
          "languageMode": "zh-CN",
          "pitchShift": 1.18,
          "languageProfiles": {
            "zh-CN": { "openai": "nova", "rate": "+0%" }
          }
        }
      }
    },
    {
      "id": "roxy-auto",
      "label": "洛琪希 · 多语言自动",
      "desc": "按回复语言自动切换中日英三套音色",
      "patch": {
        "voice": {
          "ttsProvider": "auto",
          "languageMode": "auto",
          "pitchShift": 1.15,
          "languageProfiles": {
            "ja-JP": { "openai": "nova", "rate": "+0%" },
            "zh-CN": { "openai": "nova", "rate": "+0%" },
            "en-US": { "openai": "nova", "rate": "+0%" }
          }
        }
      }
    },
    {
      "id": "neutral",
      "label": "原声 · 不做处理",
      "desc": "关闭音调处理，使用引擎默认音色",
      "patch": { "voice": { "pitchShift": 1.0 } }
    }
  ]
}
